{
    "author": "Geegaz",
    "description": "A datapack about firearms",
    "name": "GGUNZ",
    "version": "2.0.0",
    
    "data_pack": {
        "load": ["src"],
        "pack_format": 57
    },
    "resource_pack": {
        "load": ["src"],
        "pack_format": 42
    },
    "pipeline": [
        "beet.contrib.installation_advancement",
        "beet.contrib.babelbox",
        "beet.contrib.extra_files"
    ],
    "meta": {
        "installation_advancement": {
            "project_advancement_path": "ggunz:installed",
            "icon": {
                "id": "minecraft:poisonous_potato",
                "components": {
                    "item_model": "ggunz:guns/revolver",
                    "item_name": "{translate:\"ggunz.item.guns.revolver\",fallback:\"Revolver\"}"
                }
            }
        },
        "babelbox": {
            "load": ["ggunz.csv"]
        },
        "extra_files": {
            "data_pack": [
                "LICENSE.md"
            ],
            "resource_pack": [
                "LICENSE.md"
            ]
        }
    }
}